      },
      "targets": [
        { "expr": "system_voltage_volts{job=\"telemetry_app\"}", "legendFormat": "Voltage", "refId": "A" }
      ],
      "title": "Voltage Trend",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "decimals": 2, "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"telemetry_app\"}[1m]) * 100", "legendFormat": "Gunicorn worker {{instance}}", "refId": "A" }
      ],
      "title": "Application Process CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "decimals": 1, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"telemetry_app\"}", "legendFormat": "Resident memory {{instance}}", "refId": "A" }
      ],
      "title": "Application Process Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "decimals": 3, "unit": "s" },
